# Base URL for the Buildix API. In dev, leave as "/api" so Vite's proxy
# (vite.config.ts) forwards to the .NET server at http://localhost:8080.
# In production, nginx serves the SPA at "/" and the API at "/api" on the
# same origin, so "/api" works there too.
VITE_API_BASE_URL=/api

# SignalR hub base (same-origin path). Proxied in dev via vite.config.ts.
VITE_HUB_BASE_URL=/hubs

# Optional: override the dev proxy target if the API runs elsewhere.
# VITE_API_PROXY_TARGET=http://localhost:8080
