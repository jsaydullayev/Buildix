# ============================================================
# Visual Studio / Rider / VS Code
# ============================================================
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser
*_i.c
*_p.c

# ============================================================
# Secrets — NEVER commit these
# ============================================================
# Local development configuration holds real secrets (JWT key, DB password,
# SuperAdmin credentials, console segment). Only the *.example.json template
# is committed. Copy it to appsettings.Development.json and fill in locally.
appsettings.Development.json
appsettings.*.Local.json
appsettings.Local.json
*.pfx
*.key
.env
.env.*
!.env.example
secrets.json

# ============================================================
# EF Core / Database
# ============================================================
*.db
*.db-shm
*.db-wal

# ============================================================
# User-uploaded content (runtime data, not source)
# ============================================================
Buildix.API/wwwroot/uploads/

# ============================================================
# OS / misc
# ============================================================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp
*.bak

# TypeScript incremental build artifact (regenerated on every build)
*.tsbuildinfo

# ============================================================
# TLS — certificates and ACME state are runtime data, never source
# ============================================================
deploy/nginx/certs/*
!deploy/nginx/certs/.gitkeep
deploy/nginx/certbot-www/*
!deploy/nginx/certbot-www/.gitkeep
deploy/nginx/letsencrypt/

# build-desktop.ps1 yig'gan o'rnatuvchi va paketlar (~120 MB dan)
artifacts/

# Desktop yangilanish paketlari serverda turadi, git da emas (har biri 120 MB dan)
deploy/updates/*
!deploy/updates/.gitkeep
