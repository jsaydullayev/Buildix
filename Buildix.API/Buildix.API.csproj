<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <!--
    Development sozlamasi NASHRGA TUSHMASIN. Uning ichida baza paroli, JWT
    imzo kaliti, Telegram tokeni va SuperAdmin paroli bor — ular faqat
    dasturchi mashinasida qolishi kerak. `dotnet publish` sukut bo'yicha
    barcha appsettings*.json ni ko'chiradi, ya'ni desktop to'plami do'konga
    shu sirlar bilan borishi mumkin edi.
  -->
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Development.example.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!--
    Desktop to'plami: qurilgan interfeys nashr papkasidagi `spa/` ga tushadi.
    Buni qo'lda nusxalash unutilishi mumkin edi va natijada ilova bo'sh
    ekran ko'rsatardi — sababi esa faqat do'konda bilinardi.

    `dotnet publish -p:IncludeSpa=true` bilan yoqiladi. Interfeys oldindan
    `npm run build` bilan qurilgan bo'lishi kerak; qurilmagan bo'lsa nashr
    to'xtaydi va sababini aytadi.
  -->
  <Target Name="CopySpaToPublish" AfterTargets="Publish" Condition="'$(IncludeSpa)' == 'true'">
    <PropertyGroup>
      <SpaSource>$(MSBuildProjectDirectory)\..\Buildix.Web\dist</SpaSource>
    </PropertyGroup>
    <Error Condition="!Exists('$(SpaSource)')"
           Text="Interfeys qurilmagan: $(SpaSource) topilmadi. Avval Buildix.Web papkasida `npm run build` bajaring." />
    <ItemGroup>
      <SpaFiles Include="$(SpaSource)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(SpaFiles)"
          DestinationFiles="@(SpaFiles->'$(PublishDir)spa\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Importance="high" Text="Interfeys nusxalandi: @(SpaFiles->Count()) fayl → $(PublishDir)spa" />
  </Target>

  <ItemGroup>
    <Compile Remove="Controllers\NewFolder\**" />
    <Content Remove="Controllers\NewFolder\**" />
    <EmbeddedResource Remove="Controllers\NewFolder\**" />
    <None Remove="Controllers\NewFolder\**" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <!-- Serilog Logging -->
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.PostgreSQL" Version="2.3.0" />
    <PackageReference Include="QuestPDF" Version="2024.12.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Buildix.Application\Buildix.Application.csproj" />
    <ProjectReference Include="..\Buildix.Infrastructure\Buildix.Infrastructure.csproj" />
  </ItemGroup>

</Project>
