# Copy to .env and fill in real values: `cp .env.example .env`
# .env is gitignored — never commit real secrets.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=buildix
POSTGRES_PASSWORD=change-me-to-a-strong-db-password
POSTGRES_DB=buildix

# ── JWT (REQUIRED) ───────────────────────────────────────────────────────────
# Must be at least 32 characters — the API fails fast at startup otherwise.
# Generate one, e.g.:  openssl rand -base64 48
JWT_KEY=change-me-to-a-long-random-secret-of-at-least-32-characters

# ── Telegram (optional) ──────────────────────────────────────────────────────
# Bot token from @BotFather. Leave empty to disable Telegram notifications.
TELEGRAM_BOT_TOKEN=
# Webhook secret. REQUIRED for the Telegram webhook to accept updates
# (validated against the X-Telegram-Bot-Api-Secret-Token header). Register it
# with the bot's setWebhook secret_token. Leave empty if the webhook is unused.
TELEGRAM_WEBHOOK_SECRET=
