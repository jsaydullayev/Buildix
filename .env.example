# Copy to .env and fill in real values: `cp .env.example .env`
# .env is gitignored — never commit real secrets.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=buildix
POSTGRES_PASSWORD=change-me-to-a-strong-db-password
POSTGRES_DB=buildix

# ── JWT (REQUIRED) ───────────────────────────────────────────────────────────
# Must be at least 32 characters — the API fails fast at startup otherwise.
# Generate one, e.g.:  openssl rand -base64 48
JWT_KEY=change-me-to-a-long-random-secret-of-at-least-32-characters

# ── SuperAdmin console (REQUIRED) ────────────────────────────────────────────
# The platform console lives under a hidden URL segment: /api/_sa/<segment>/…
# Anything that does not match returns 404 *before* authentication, so scanners
# never learn the console exists. Treat it as a secret; generate one with:
#   openssl rand -hex 16
# The superadmin does not have to type it: after signing in on the ordinary
# login page the API hands the segment to that account only.
SUPERADMIN_CONSOLE_SEGMENT=change-me-to-a-random-32-hex-string
# Seeded on first boot. Change the password after the first sign-in.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change-me-to-a-strong-password

# ── Tashqi portlar ───────────────────────────────────────────────────────────
# Standart — mashinaning 80/443 portlari (Buildix yolg'iz turgan server).
#
# Serverda boshqa loyihalar va umumiy reverse proxy bo'lsa, 80/443 band bo'ladi:
# Buildix'ni ichki portga ko'chiring va tashqi proxy'dan shu yerga uzating.
# 127.0.0.1 prefiksini TUSHIRIB QOLDIRMANG — usiz port butun internetga
# ochiladi va tashqi proxy'ni (demak TLS va uning cheklovlarini) chetlab o'tish
# mumkin bo'ladi.
#   WEB_HTTP_PORT=127.0.0.1:8090
#   WEB_HTTPS_PORT=127.0.0.1:8453
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

# ── nginx / TLS ──────────────────────────────────────────────────────────────
# default.ssl.conf (default) = HTTPS on :443 + HTTP→HTTPS redirect. Until certbot
# issues a real certificate the container generates a temporary self-signed one,
# so the stack still starts (the browser will warn). See deploy/README.md → TLS.
# Set to default.conf ONLY for local runs where plain HTTP is acceptable.
NGINX_CONF=default.ssl.conf

# ── Desktop yangilanishlari ──────────────────────────────────────────────────
# Do'kon ilovasi yangi versiyani shu papkadan oladi (nginx uni /updates/ da
# beradi). Paketlar 120 MB dan, shuning uchun ular repo ichida saqlanmaydi —
# serverda kengroq diskdagi yo'lni ko'rsatgan ma'qul:
#   UPDATES_DIR=/srv/buildix/updates
# Fayllarni to'g'ridan-to'g'ri ildizga emas, ichidagi taxmin qilib bo'lmaydigan
# papkaga qo'ying (papkada mahsulotning o'zi yotadi) — deploy/README.md §5.
UPDATES_DIR=./deploy/updates

# ── Log retention ────────────────────────────────────────────────────────────
# Days of `app_logs` history to keep; the API purges older rows once a day.
# 0 disables the purge (use only with an external log collector).
LOG_RETENTION_DAYS=30

# ── Telegram (optional) ──────────────────────────────────────────────────────
# Bot token from @BotFather. Leave empty to disable Telegram notifications.
TELEGRAM_BOT_TOKEN=
# The bot's @username (without @) — the Account page shows an "open the bot"
# button pointing to t.me/<this>. Empty hides the button.
TELEGRAM_BOT_USERNAME=buildix_uz_bot
# Webhook secret. REQUIRED for the Telegram webhook to accept updates
# (validated against the X-Telegram-Bot-Api-Secret-Token header). Register it
# with the bot's setWebhook secret_token. Leave empty if the webhook is unused.
TELEGRAM_WEBHOOK_SECRET=
# Local (Tashkent) hour the automatic day summary is sent at, 0–23. Default 21.
TELEGRAM_DAILY_SUMMARY_HOUR=21

# ── Desktop app (optional) ───────────────────────────────────────────────────
# Where the shop installer sits. The owner sees a download button in Настройки
# once this is set; empty shows "not available yet" instead. Only a signed-in
# OWNER ever receives this URL, so the folder may stay secret:
#   https://buildix.uz/updates/<SECRET>/Buildix-win-Setup.exe
DESKTOP_INSTALLER_URL=
# Shown next to the button ("versiya 1.0.3"). NORMALDA BO'SH QOLDIRILADI:
# versiya paketlar papkasidagi releases.win.json dan o'qiladi, ya'ni yangi
# paket qo'yilishi bilan o'zi yangilanadi. Bu yerga qiymat yozilsa u faqat
# ZAXIRA bo'lib qoladi (fayl o'qilmagan holat uchun) — va eskirib qolsa
# sahifa egaga yolg'on raqam ko'rsatadi, buni esa hech kim sezmaydi.
DESKTOP_VERSION=
